        "status": { "type": "string", "enum": ["success", "partial", "failed"] },
        "startedAt": { "type": "string", "maxLength": 100 },
        "finishedAt": { "type": "string", "maxLength": 100 },
        "durationMs": { "type": "number" },
        "usersEvaluated": { "type": "number" },
        "notificationsCreated": { "type": "number" }
      },
      "required": ["id", "trigger", "status", "startedAt"]
    },
    "UserJobApplication": {
      "title": "Job Application",
      "description": "Direct job application submitted by an authenticated job seeker.",
