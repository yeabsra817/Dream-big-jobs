        "country": { "type": "string", "maxLength": 100 },
        "universityOrInstitution": { "type": "string", "maxLength": 250 },
        "scholarshipName": { "type": "string", "maxLength": 250 },
        "officialApplicationUrl": { "type": "string", "maxLength": 1000 },
        "originalSourceUrl": { "type": "string", "maxLength": 1000 },
