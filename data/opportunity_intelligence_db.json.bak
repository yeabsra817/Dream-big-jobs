    {
      "id": "opp_ba02fe3e3a4fe53e762464b0",
      "canonicalKey": "ba02fe3e3a4fe53e762464b0",
      "urlFingerprint": "55c4f51c1a3d47f6fc66390a",
      "updateVersion": 1,
      "category": "job",
      "environment": "international",
      "title": "Technology Consultant - AI Visibility (w/m/d)",
      "employer": "SCAILE TECHNOLOGIES GmbH",
      "country": "Munich",
      "city": "",
      "region": "International",
      "sector": "other",
      "secondarySectors": [],
      "seniorityLevel": "senior_professional",
      "actualResponsibilities": [
        "Implementierung beim Kunden: Du bringst die technische Basis beim Kunden zum Laufen.",
        "Reporting: Du zeigst Kunden im wöchentlichen Termin, was sich bewegt, von Klicks und CTR bis zu Zitationen in AI Search, und leitest klare nächste Schritte ab."
      ],
      "descriptionSummary": "Du hast in einer Beratung Technik und Business zusammengebracht und Kunden bis in die Umsetzung begleitet. Jetzt machst du das für das, was nach der klassischen Suche kommt. Du weißt, dass eine Strategie erst zählt, wenn sie beim Kunden läuft. Und du siehst, dass die Antwort immer öfter direkt in ChatGPT, Perplexity oder den AI Overviews steht. Für Marken zählt deshalb, ob sie dort als Quelle auftauchen. scaile - AI ",
