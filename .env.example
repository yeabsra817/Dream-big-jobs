# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token for DreamBigJobsEthiopiaBot obtained from @BotFather.
# Stored securely on the server side for Telegram Bot API integration.
# Configure this via the Secrets panel in AI Studio or via the secure Admin Telegram Setup.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# DEVELOPER_PASSWORD: Optional server-side developer login secret (never exposed to client).
# When configured, the server hashes and verifies it with salted scrypt across deployments.
DEVELOPER_PASSWORD="MY_DEVELOPER_PASSWORD"

# SMTP_* : Required for automated personalized vacancy email alerts.
# Configure these in Vercel Project Settings -> Environment Variables (never commit secrets).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="nexusitsoultion@gmail.com"
SMTP_PASS=""
SMTP_FROM="nexusitsoultion@gmail.com"

# VAPID_* : Web Push VAPID keys. Preserve existing keys across all deployments!
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:nexusitsoultion@gmail.com"

# CRON_SECRET : Bearer secret used by Vercel Cron (/api/cron/notifications & /api/cron/global-opportunities) to authorize scheduled sweeps.
CRON_SECRET=""

# GLOBAL OPPORTUNITY INTELLIGENCE — 24/7 ETHIOPIA TIME (Africa/Addis_Ababa) 6-HOUR SCHEDULE
# Runs automatically at 00:00, 06:00, 12:00, and 18:00 EAT (UTC cron: 0 3,9,15,21 * * *), 365 days/year.
# Note: Google Custom Search JSON API (GOOGLE_SEARCH_API_KEY / GOOGLE_SEARCH_CX) is NOT required.
# Default schedule interval in minutes (360 = every 6 hours, aligned to 00:00, 06:00, 12:00, 18:00 Africa/Addis_Ababa)
DISCOVERY_INTERVAL_MINUTES="360"
# Free official ReliefWeb UN/INGO feeds + Direct Official Institutional Website Monitors run automatically with zero API keys.
# Primary live web discovery uses GEMINI_API_KEY with native Google Search grounding.
# Optional comma-separated provider list: "auto" (default) or any subset of "reliefweb,direct_websites,gemini,tavily,brave"
OPPORTUNITY_SEARCH_PROVIDERS="auto"

# Tavily Search API (optional live web search fallback; free tier offers 1,000 credits/month, no credit card)
TAVILY_API_KEY=""

# Brave Search API (optional live web search fallback; $5/month free credit ~1,000 queries/month)
BRAVE_SEARCH_API_KEY=""

# ReliefWeb Official UN/INGO feed identifier (optional, free, no API key required)
RELIEFWEB_APPNAME="hopelandjobs-opportunity-intel"

# CONTINUOUS 1-MINUTE AUTONOMOUS DISCOVERY WORKER (Independent of GitHub Actions 5-minute cron minimum)
# Interval in seconds for the built-in continuous worker or standalone worker (npm run worker:discovery). Default: 60
AUTONOMOUS_TICK_INTERVAL_SECONDS="60"

# OWNER_ALERT_EMAIL : Optional recipient email for new verified matching opportunity alerts (defaults to SMTP_USER when SMTP is configured)
OWNER_ALERT_EMAIL=""


