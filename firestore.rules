rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email != null && (
            request.auth.token.email.matches('(?i)^nexusitsoultion@gmail\\.com$') ||
            request.auth.token.email.matches('(?i)^yeabsra45@gmail\\.com$')
          )
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProfileWrite(data, userId) {
      return data.uid is string
        && data.uid == userId
        && data.email is string && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() <= 200
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (!('accountRole' in data) || (data.accountRole is string && data.accountRole in ['staff', 'job_seeker']))
        && (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['active', 'inactive', 'suspended']))
        && (!('preferredSectors' in data) || (data.preferredSectors is list && data.preferredSectors.size() <= 30))
        && (!('currentPosition' in data) || data.currentPosition == null || (data.currentPosition is string && data.currentPosition.size() <= 200))
        && (!('staffDepartmentOrSector' in data) || data.staffDepartmentOrSector == null || (data.staffDepartmentOrSector is string && data.staffDepartmentOrSector.size() <= 200))
        && (!('skills' in data) || (data.skills is list && data.skills.size() <= 100))
        && (!('areasOfExpertise' in data) || (data.areasOfExpertise is list && data.areasOfExpertise.size() <= 100))
        && (!('professionalInterests' in data) || (data.professionalInterests is list && data.professionalInterests.size() <= 100))
        && (!('previousPositions' in data) || (data.previousPositions is list && data.previousPositions.size() <= 50))
        && (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 50))
        && (!('savedJobIds' in data) || (data.savedJobIds is list && data.savedJobIds.size() <= 200))
        && (!('noExperience' in data) || data.noExperience is bool)
        && (!('profileStatus' in data) || (data.profileStatus is string && data.profileStatus in ['complete', 'incomplete']))
        && !('isAdmin' in data)
        && !('role' in data);
    }

    function isValidAnalyticsVisitorWrite(data, visitorKeyParam) {
      return data.keys().hasAll(['visitorKey', 'dateKey', 'firstSeenAt', 'lastSeenAt', 'isSignedIn', 'isInternal', 'source', 'deviceType', 'pageViews', 'aiInteractionsCount'])
        && data.keys().hasOnly(['visitorKey', 'dateKey', 'firstSeenAt', 'lastSeenAt', 'isSignedIn', 'isInternal', 'source', 'deviceType', 'pageViews', 'aiInteractionsCount', 'lastEventType'])
        && data.visitorKey is string && data.visitorKey == visitorKeyParam && data.visitorKey.size() <= 128
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.firstSeenAt is string && data.firstSeenAt.size() <= 64
        && data.lastSeenAt is string && data.lastSeenAt.size() <= 64
        && data.isSignedIn is bool
        && data.isInternal is bool
        && data.source is string && data.source in ['direct', 'google', 'telegram', 'facebook', 'referral', 'other']
        && data.deviceType is string && data.deviceType in ['mobile', 'desktop', 'tablet']
        && data.pageViews is number && data.pageViews >= 0 && data.pageViews <= 1000000
        && data.aiInteractionsCount is number && data.aiInteractionsCount >= 0 && data.aiInteractionsCount <= 1000000
        && (!('lastEventType' in data) || (data.lastEventType is string && data.lastEventType.size() <= 64));
    }

    function isValidAnalyticsEventCreate(data, eventIdParam) {
      return data.keys().hasAll(['id', 'visitorKey', 'sessionId', 'eventType', 'path', 'source', 'deviceType', 'timestamp', 'isInternal'])
        && data.id is string && data.id == eventIdParam && data.id.size() <= 128
        && data.visitorKey is string && data.visitorKey.size() <= 128
        && data.sessionId is string && data.sessionId.size() <= 128
        && data.eventType is string && data.eventType.size() <= 64
        && data.path is string && data.path.size() <= 300
        && data.source is string && data.source in ['direct', 'google', 'telegram', 'facebook', 'referral', 'other']
        && data.deviceType is string && data.deviceType in ['mobile', 'desktop', 'tablet']
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.isInternal is bool
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('jobId' in data) || (data.jobId is string && data.jobId.size() <= 128))
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 200))
        && (!('organization' in data) || (data.organization is string && data.organization.size() <= 200))
        && (!('category' in data) || (data.category is string && data.category.size() <= 120))
        && (!('searchTerm' in data) || (data.searchTerm is string && data.searchTerm.size() <= 200))
        && (!('filterType' in data) || (data.filterType is string && data.filterType.size() <= 100));
    }

    function isValidApplicationCreate(data, appId) {
      return data.id is string
        && data.id == appId
        && data.userId is string
        && data.userId == request.auth.uid
        && data.vacancyId is string && data.vacancyId.size() <= 128
        && data.status == 'submitted';
    }

    // Vacancies Collection
    match /vacancies/{vacancyId} {
      // Public can directly view published, expired, closed, or archived vacancies via deep links (e.g. Telegram);
      // drafts and duplicates remain strictly admin-only, and public list queries only return published jobs.
      allow get: if isValidId(vacancyId) && (
        (resource.data.status in ['published', 'expired', 'closed', 'archived']) || isOwnerAdmin()
      );
      allow list: if (resource.data.status == 'published') || isOwnerAdmin();

      // Only the verified website owner/admin can create, update, or delete vacancies
      allow create: if isOwnerAdmin() && isValidId(vacancyId);
      allow update: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }

    // Duplicate Reports Collection
    match /duplicates/{duplicateId} {
      allow read, write: if isOwnerAdmin();
    }

    // Telegram Posting Batches Collection
    match /telegramBatches/{batchId} {
      allow read, write: if isOwnerAdmin();
    }

    // Site Settings Collection (e.g. Telegram links, contact info)
    match /siteSettings/{settingId} {
      // Public can read general settings for Telegram channel link & contact
      allow get, list: if true;
      allow write: if isOwnerAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isOwnerAdmin();
      allow write: if isOwnerAdmin();
    }

    // Job Seeker & Staff Profiles Collection (Owner-scoped PII protection)
    match /job_seeker_profiles/{userId} {
      allow get: if (isSignedIn() && isValidId(userId) && request.auth.uid == userId) || isOwnerAdmin();
      allow list: if isOwnerAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidProfileWrite(request.resource.data, userId)
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'active');
      allow update: if (
        isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidProfileWrite(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && (!('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus)
      ) || isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }

    // Personalized User Recommendations (Strictly scoped to owning user or admin)
    match /user_recommendations/{recId} {
      allow get: if isSignedIn() && isValidId(recId) && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create, update: if isSignedIn() && isValidId(recId)
        && request.resource.data.userId is string
        && (request.resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
    }

    // Personalized Job Notifications (Strictly scoped to owning user or admin)
    match /user_notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId) && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create: if isSignedIn() && isValidId(notifId)
        && request.resource.data.userId is string
        && (request.resource.data.userId == request.auth.uid || isOwnerAdmin())
        && request.resource.data.read is bool;
      allow update: if isSignedIn() && isValidId(notifId)
        && (resource.data.userId == request.auth.uid || isOwnerAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwnerAdmin();
    }

    // User Notification Preferences & Device Subscriptions (Strictly scoped to owning user or admin)
    match /user_notification_preferences/{userId} {
      allow get: if (isSignedIn() && isValidId(userId) && request.auth.uid == userId) || isOwnerAdmin();
      allow list: if isOwnerAdmin();
      allow create, update: if isSignedIn() && isValidId(userId)
        && (request.auth.uid == userId || isOwnerAdmin())
        && request.resource.data.userId == userId
        && request.resource.data.permissionStatus in ['default', 'granted', 'denied', 'unsupported']
        && request.resource.data.subscriptionStatus in ['active', 'none', 'expired', 'revoked']
        && (!('frequency' in request.resource.data) || request.resource.data.frequency in ['instant', 'daily', 'weekly']);
      allow delete: if isOwnerAdmin();
    }

    // Device-level Web Push Subscriptions (Strictly isolated to owning user or admin)
    match /push_subscriptions/{subId} {
      allow get: if isSignedIn() && isValidId(subId) && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create, update: if isSignedIn() && isValidId(subId)
        && request.resource.data.id is string && request.resource.data.id == subId
        && request.resource.data.userId is string && (request.resource.data.userId == request.auth.uid || isOwnerAdmin())
        && request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 128
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1000
        && (!('keys' in request.resource.data) || request.resource.data.keys == null || request.resource.data.keys is map)
        && request.resource.data.active is bool;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
    }

    function isValidAnonymousPushSubWrite(data, deviceIdParam) {
      return data.keys().hasAll(['deviceId', 'endpoint', 'keys', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['deviceId', 'deviceLabel', 'platform', 'endpoint', 'expirationTime', 'keys', 'active', 'createdAt', 'updatedAt'])
        && data.deviceId is string && data.deviceId == deviceIdParam && data.deviceId.size() <= 128
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 150))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 60))
        && data.endpoint is string && data.endpoint.size() >= 10 && data.endpoint.size() <= 1000 && data.endpoint.matches('^https://.*')
        && (!('expirationTime' in data) || data.expirationTime == null || data.expirationTime is number)
        && data.keys is map
        && data.keys.keys().hasAll(['p256dh', 'auth'])
        && data.keys.keys().hasOnly(['p256dh', 'auth'])
        && data.keys.p256dh is string && data.keys.p256dh.size() >= 10 && data.keys.p256dh.size() <= 300
        && data.keys.auth is string && data.keys.auth.size() >= 10 && data.keys.auth.size() <= 128
        && data.active is bool
        && data.createdAt is string && data.createdAt.size() <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // Write-only visitor Web Push subscriptions (claimed on user login/signup; zero public read/list)
    match /anonymous_push_subscriptions/{deviceId} {
      allow get, list, delete: if isOwnerAdmin();
      allow create: if isValidId(deviceId)
        && isValidAnonymousPushSubWrite(request.resource.data, deviceId);
      allow update: if isValidId(deviceId)
        && isValidAnonymousPushSubWrite(request.resource.data, deviceId)
        && request.resource.data.deviceId == resource.data.deviceId;
    }

    // Server / Admin-only Notification Retry Queue & Scheduler Execution History
    match /notification_queue/{queueId} {
      allow read, write: if isOwnerAdmin();
    }

    match /scheduler_runs/{runId} {
      allow read, write: if isOwnerAdmin();
    }

    // Job Applications Collection (Owner-scoped read/create, Admin review)
    match /job_applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create: if isSignedIn() && isValidId(applicationId)
        && isValidApplicationCreate(request.resource.data, applicationId);
      allow update: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }

    // Personal AI Auto Apply Collections (Strictly Private to Owner Admin)
    match /autoApplyApplications/{docId} {
      allow read, write: if isOwnerAdmin();
    }
    match /autoApplyProfile/{docId} {
      allow read, write: if isOwnerAdmin();
    }
    match /autoApplyDocuments/{docId} {
      allow read, write: if isOwnerAdmin();
    }

    // First-party non-PII Analytics Visitors & Events (enables live visit tracking on static hosting)
    match /analytics_visitors/{visitorKey} {
      allow get, list: if true;
      allow create, update: if isValidId(visitorKey)
        && isValidAnalyticsVisitorWrite(request.resource.data, visitorKey);
      allow delete: if isOwnerAdmin();
    }

    match /analytics_events/{eventId} {
      allow create: if isValidId(eventId)
        && isValidAnalyticsEventCreate(request.resource.data, eventId);
      allow get, list, update, delete: if isOwnerAdmin();
    }

    function isValidApprovalFields(data) {
      return (!('approvalStatus' in data) || (data.approvalStatus is string && data.approvalStatus in ['private_pending', 'approved_public', 'rejected', 'expired']))
        && (!('discoveredAt' in data) || (data.discoveredAt is string && data.discoveredAt.size() <= 100))
        && (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 100));
    }

    function isValidInternationalJobWrite(data) {
      return data.id is string && data.id.size() <= 128
        && data.country is string && data.country.size() <= 100
        && data.employerOrProgramme is string && data.employerOrProgramme.size() <= 250
        && data.jobTitle is string && data.jobTitle.size() <= 250
        && data.directApplicationUrl is string && data.directApplicationUrl.size() <= 1000
        && data.originalSourceUrl is string && data.originalSourceUrl.size() <= 1000
        && data.verificationStatus is string && data.verificationStatus in ['VERIFIED', 'UNVERIFIED', 'SUSPENDED_BROKEN_LINK', 'EXPIRED', 'REJECTED_SUSPICIOUS']
        && isValidApprovalFields(data);
    }

    function isValidImmigrationWrite(data) {
      return data.id is string && data.id.size() <= 128
        && data.country is string && data.country.size() <= 100
        && data.pathwayTitle is string && data.pathwayTitle.size() <= 250
        && data.officialGovernmentWebsite is string && data.officialGovernmentWebsite.size() <= 1000
        && data.originalSourceUrl is string && data.originalSourceUrl.size() <= 1000
        && data.verificationStatus is string && data.verificationStatus in ['VERIFIED', 'UNVERIFIED', 'SUSPENDED_BROKEN_LINK', 'EXPIRED', 'REJECTED_SUSPICIOUS']
        && isValidApprovalFields(data);
    }

    function isValidScholarshipWrite(data) {
      return data.id is string && data.id.size() <= 128
        && data.country is string && data.country.size() <= 100
        && data.universityOrInstitution is string && data.universityOrInstitution.size() <= 250
        && data.scholarshipName is string && data.scholarshipName.size() <= 250
        && data.officialApplicationUrl is string && data.officialApplicationUrl.size() <= 1000
        && data.originalSourceUrl is string && data.originalSourceUrl.size() <= 1000
        && data.verificationStatus is string && data.verificationStatus in ['VERIFIED', 'UNVERIFIED', 'SUSPENDED_BROKEN_LINK', 'EXPIRED', 'REJECTED_SUSPICIOUS']
        && isValidApprovalFields(data);
    }

    // International Jobs Collection (Public can only read VERIFIED and approved_public entries; private_pending entries are strictly Yeabsra-only)
    match /international_jobs/{jobId} {
      allow get, list: if ((resource.data.verificationStatus == 'VERIFIED') && (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'approved_public')) || isOwnerAdmin();
      allow create, update: if isOwnerAdmin() && isValidId(jobId) && isValidInternationalJobWrite(request.resource.data);
      allow delete: if isOwnerAdmin();
    }

    // International Immigration & Permanent Residence Pathways (Public can only read VERIFIED and approved_public entries)
    match /immigration_pathways/{pathwayId} {
      allow get, list: if ((resource.data.verificationStatus == 'VERIFIED') && (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'approved_public')) || isOwnerAdmin();
      allow create, update: if isOwnerAdmin() && isValidId(pathwayId) && isValidImmigrationWrite(request.resource.data);
      allow delete: if isOwnerAdmin();
    }

    // Experience-Based Scholarships (Public can only read VERIFIED and approved_public entries)
    match /experience_scholarships/{scholarshipId} {
      allow get, list: if ((resource.data.verificationStatus == 'VERIFIED') && (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'approved_public')) || isOwnerAdmin();
      allow create, update: if isOwnerAdmin() && isValidId(scholarshipId) && isValidScholarshipWrite(request.resource.data);
      allow delete: if isOwnerAdmin();
    }

    // Automated Research History & Official Source Verification Reports (Admin only)
    match /research_history/{runId} {
      allow read, write: if isOwnerAdmin();
    }

    match /verification_logs/{logId} {
      allow read, write: if isOwnerAdmin();
    }

    match /monitored_sources/{sourceId} {
      allow read, write: if isOwnerAdmin();
    }

    match /developer_notifications/{notifId} {
      allow read, write: if isOwnerAdmin();
    }

    match /telegram_retry_queue/{retryId} {
      allow read, write: if isOwnerAdmin();
    }

    // Owner-Only Persistence, Audit History & Backup Collections
    match /audit_logs/{logId} {
      allow get, list: if isOwnerAdmin();
      allow create: if isOwnerAdmin() && isValidId(logId);
      allow update, delete: if false;
    }

    match /admin_notifications/{notifId} {
      allow read, write: if isOwnerAdmin();
    }

    match /system_backups/{backupId} {
      allow read, write: if isOwnerAdmin();
    }

    // Test Collection (for connectivity verification)
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}
