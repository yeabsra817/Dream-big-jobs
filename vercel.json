{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 */3 * *"
    },
    {
      "path": "/api/cron/global-opportunities",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-opportunity-intelligence",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data/*.json,public/*.png,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/__/auth/:match*",
      "destination": "https://gen-lang-client-0056760370.firebaseapp.com/__/auth/:match*"
    },
    {
      "source": "/__/firebase/:match*",
      "destination": "https://gen-lang-client-0056760370.firebaseapp.com/__/firebase/:match*"
    },
    {
      "source": "/((?!api/|__/auth/|__/firebase/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/pwa-icon/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
